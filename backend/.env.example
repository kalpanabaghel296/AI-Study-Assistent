GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=ai_study_assistant
FRONTEND_ORIGIN=http://localhost:5173
MAX_PDF_MB=10

# Authentication (generate a long random value; keep it private)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=10080
OTP_EXPIRE_MINUTES=10
OTP_RESEND_SECONDS=60

# Gmail SMTP; use a Google App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=yourgmail@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=yourgmail@gmail.com
SMTP_FROM_NAME=BACKBENCH
